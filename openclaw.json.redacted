{
  "agents": {
    "defaults": {
      "compaction": {
        "memoryFlush": {
          "enabled": true
        },
        "mode": "safeguard"
      },
      "contextPruning": {
        "keepLastAssistants": 5,
        "mode": "cache-ttl",
        "ttl": "30m"
      },
      "heartbeat": {
        "every": "0",
        "model": "openrouter/openai/gpt-4o-mini"
      },
      "maxConcurrent": 4,
      "memorySearch": {
        "experimental": {
          "sessionMemory": true
        },
        "sources": [
          "memory",
          "sessions"
        ]
      },
      "subagents": {
        "maxConcurrent": 8
      },
      "workspace": "/home/node/.openclaw/workspace"
    },
    "list": [
      {
        "id": "main",
        "model": "openrouter/google/gemini-3-flash-preview",
        "subagents": {
          "allowAgents": [
            "business",
            "personal",
            "work",
            "background"
          ],
          "model": "openrouter/google/gemini-3-flash-preview"
        },
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "business",
        "model": "openrouter/google/gemini-3-flash-preview",
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "personal",
        "model": "anthropic/claude-sonnet-4-5",
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "work",
        "model": "openrouter/google/gemini-3-flash-preview",
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "background",
        "model": "openrouter/openai/gpt-4o-mini",
        "workspace": "/home/node/.openclaw/workspace"
      }
    ]
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "mode": "api_key",
        "provider": "anthropic"
      },
      "openrouter:default": {
        "mode": "api_key",
        "provider": "openrouter"
      }
    }
  },
  "bindings": [
